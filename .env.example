# App server (VM 1) - set these in Coolify > Environment Variables, never commit real values.
VULTR_INFERENCE_API_KEY=your-inference-subscription-key
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
MODEL_MAIN=minimax-m3.1-flash
MODEL_FALLBACK=deepseek-v4.1-flash-1017
RUNNER_URL=http://10.6.96.6:8080
RUNNER_TOKEN=token-printed-by-install-runner.sh
MAX_ATTEMPTS=3
RUN_TIMEOUT_S=30
RUN_MEMORY_MB=512
RATE_LIMIT_PER_HOUR=40

# Supabase (self-hosted through Coolify on Vultr). The service-role key stays on the app server only.
SUPABASE_URL=https://db.agentrush.aashirnoman.dev
SUPABASE_ANON_KEY=from-coolify-SERVICE_SUPABASEANON_KEY
SUPABASE_SERVICE_ROLE_KEY=from-coolify-SERVICE_SUPABASESERVICE_KEY
SAFETY_MODEL=nemotron-3.5-content-safety
APPROVAL_TIMEOUT_S=600
VISION_MODEL=nemotron-3-nano-omni-30b-a3b-reasoning

# Fresh-VM mode (optional). Restrict this key to the app server's IP in the Vultr console.
VULTR_API_KEY=
DISPOSABLE_SNAPSHOT_DESC=agentrush-exec-template
DISPOSABLE_TEMPLATE_LABEL=agentrush-exec
DISPOSABLE_MAX_AGE_MIN=15
DISPOSABLE_POOL_SIZE=1

# Receipt archive on Vultr Object Storage (optional)
VULTR_S3_ENDPOINT=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
VULTR_S3_BUCKET=countersign-receipts
